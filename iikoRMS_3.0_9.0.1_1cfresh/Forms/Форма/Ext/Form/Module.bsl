&НаСервере	
Процедура ДобавитьКонтрагентов(тз,ВИД)     	
	для Каждого нн из ТЗ Цикл
		Попытка
			Если ПустаяСтрока(нн.ККодИИКО) Тогда  
				нн.ККодИИКО = Лев(нн.КНаименованиеИИКО,11);
			КонецЕсли;
			Если ЗначениеЗаполнено(нн.КНаименованиеИИКО) тогда
				Если Объект.Контрагенты.НайтиСтроки(Новый Структура ("ККодИИКО", нн.ККодИИКО)).Количество() = 0 Тогда
					ххх = Объект.Контрагенты.Добавить();
					ххх.КИННИИКО = ИсправленныйЮЛИНН(нн.КИННИИКО);
					ххх.ККодИИКО = нн.ККодИИКО;
					ххх.КНаименованиеИИКО = нн.КНаименованиеИИКО;
				КонецЕсли;
			иначе
				Продолжить;
			конецЕсли;
		Исключение
			Если Вид = "ВПР" И НЕ ЗначениеЗаполнено(нн.РасходнаяНакладнаяНомер) тогда
				Продолжить;
			КонецЕсли;
			
			Если ПустаяСтрока(нн.ПокупательКод) Тогда  
				нн.ПокупательКод = Лев(нн.ПокупательНаименование,11);
			КонецЕсли;
			Если ЗначениеЗаполнено(нн.ПокупательНаименование) тогда
				Если Объект.Контрагенты.НайтиСтроки(Новый Структура ("ККодИИКО", нн.ПокупательКод)).Количество() = 0 Тогда
					ххх = Объект.Контрагенты.Добавить();
					ххх.КИННИИКО = ИсправленныйЮЛИНН(нн.ПокупательИНН);
					ххх.ККодИИКО = нн.ПокупательКод;
					ххх.КНаименованиеИИКО = нн.ПокупательНаименование;
				КонецЕсли;
			иначе
				Продолжить;
			конецЕсли;
		КонецПопытки;
	КонецЦикла;   	
КонецПроцедуры

