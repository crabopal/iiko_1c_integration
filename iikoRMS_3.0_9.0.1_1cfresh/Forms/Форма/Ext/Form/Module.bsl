&НаСервере
Процедура ОбновитьСписокДокументов()
   ОБъект.Докум.Очистить();
	
	Если Пн и ЗначениеЗаполнено(АдресПн) тогда
		ЗаполнитьДокументы(тз,"Приходная Накладная",Объект.ДеньПрефикс,Ложь);
	КонецЕсли;
	
	Если АР и ЗначениеЗаполнено(АдресАР) тогда
		ЗаполнитьДокументы(тз1,"Акт Реализации",Объект.ДеньАР_ОПЗСПрефикс,Ложь);
	КонецЕсли;
	
	Если ВП и ЗначениеЗаполнено(АдресВП) тогда
		ЗаполнитьДокументы(тз2,"Внутреннее Перемещение",Объект.ДеньПрефикс,Ложь);
	КонецЕсли;
	
	Если АП и ЗначениеЗаполнено(АдресАП) тогда
		ЗаполнитьДокументы(тз3,"Акт Приготовления",Объект.ДеньАПриготовленияПрефикс,Ложь);
	КонецЕсли;
	
	Если АС и ЗначениеЗаполнено(АдресАС) тогда
		ЗаполнитьДокументы(тз6,"Акт Списания",Объект.ДеньАС_ОПЗСПрефикс,Ложь);
	КонецЕсли;	
	
	Если АПЕР и ЗначениеЗаполнено(АдресАПЕР) тогда
		ЗаполнитьДокументы(тз5,"Акт Переработки",Объект.ДеньАПерараоткиПрефикс,Ложь);
	КонецЕсли;
	
	Если РН и ЗначениеЗаполнено(АдресРН) тогда
		ЗаполнитьДокументы(тз8,"Расходная Накладная",Объект.ДеньРН_ОПЗСПрефикс,Ложь);
	КонецЕсли;
	
	Если ИН и ЗначениеЗаполнено(АдресИН) тогда
		ЗаполнитьДокументы(тз7,"Инвентаризация",Объект.ДеньПрефикс,Ложь);
	КонецЕсли;	
	
	Если АР и БезналичныеОплаты = "ИзПриемаКассовойВыручки" и ЗначениеЗаполнено(АдресАРиБезнал) тогда
		Тз4 = ПолучитьИзВременногоХранилища(АдресАРиБезнал);
		ЗаполнитьДокументы(тз4,"Прием кассовой выручки",Объект.ДеньПрефикс,Ложь);
	КонецЕсли;
	
	Если ВН и ЗначениеЗаполнено(АдресВН) тогда
		ЗаполнитьДокументы(тз9,"Возвратная Накладная",Объект.ДеньПрефикс,Ложь);
	КонецЕсли;
	
	Если АУ и ЗначениеЗаполнено(АдресАУ) тогда 
		ЗаполнитьДокументы(тз10,"Акт оказания услуг",Объект.ДеньПрефикс,Ложь);	
	КОнецЕсли;
	
	Если АПУ и ЗначениеЗаполнено(АдресАПУ) тогда 
		ЗаполнитьДокументы(тз11,"Акт приёма услуг",Объект.ДеньПрефикс,Ложь);		
	КонецЕсли;
	
	Если АРаз и ЗначениеЗаполнено(АдресАРаз) тогда 
		ЗаполнитьДокументы(тз12,"Акт разбора",Объект.ДеньПрефикс,Ложь);		
	КонецЕсли;
	
    Если ВПР и ЗначениеЗаполнено(АдресВПР) тогда 
		ЗаполнитьДокументы(тз13,"Возврат от покупателя",Объект.ДеньПрефикс, Истина);		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция НайтиПКО(ООРП)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриходныйКассовыйОрдер.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	               |ГДЕ
	               |	ПриходныйКассовыйОрдер.ДокументОснование = &ДокументОснование";
	Запрос.УстановитьПараметр("ДокументОснование",ООРП.Ссылка);
	
	Результат = Запрос.Выполнить().Выгрузить();

	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
КонецФункции
