		КонецЦикла;
		АдресВП = ПоместитьВоВременноеХранилище(Тз2, УИДФормы);
	КонецЕсли;
	
	Если РН и ЗначениеЗаполнено(АдресРН) Тогда
		Тз8 = ПолучитьИзВременногоХранилища(АдресРН);
		ТаблицаКонцепций = ТЗ8.Скопировать();
