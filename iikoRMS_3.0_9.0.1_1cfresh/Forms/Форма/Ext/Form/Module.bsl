Процедура КонтрагентыПередУдалением(Элемент, Отказ)
	НаимУдаляемых ="";
	Для каждого Номер из Элементы.Контрагенты.ВыделенныеСтроки  Цикл
		
		НаимУдаляемых = Объект.Контрагенты.НайтиПоИдентификатору(Номер).КНаименованиеИИКО + ", " + НаимУдаляемых;
		
	КонецЦикла;
	
	Если Элементы.Контрагенты.ВыделенныеСтроки.Количество() = 1 Тогда
		ТекстВопроса = "Удалить из загрузки все документы с контрагентом: ";
	Иначе
		ТекстВопроса = "Удалить из загрузки все документы с контрагентами: ";
	КонецЕсли;
	
	Ответ = Вопрос(ТекстВопроса +
	НаимУдаляемых +"?", 
	РежимДиалогаВопрос.ДаНет); 
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Отказ=истина;
		Возврат;
	КонецЕсли;
	
	Для каждого Номер из Элементы.Контрагенты.ВыделенныеСтроки  Цикл
		
		
		КодАйко= Объект.Контрагенты.НайтиПоИдентификатору(Номер).КНаименованиеИИКО;
		
		Доки = Объект.Докум.НайтиСТроки(Новый структура("Контрагент, ВидДок",КодАйко,"Приходная Накладная"));
		Доки2 = Объект.Докум.НайтиСТроки(Новый структура("Контрагент, ВидДок",КодАйко,"Расходная Накладная"));
		Доки3 = Объект.Докум.НайтиСТроки(Новый структура("Контрагент, ВидДок",КодАйко,"Акт оказания услуг"));
		Доки4 = Объект.Докум.НайтиСТроки(Новый структура("Контрагент, ВидДок",КодАйко,"Акт приёма услуг"));

		
		
		Если Доки.КОличество() > 0 тогда 
			Индекс = Доки.Количество() - 1;
			Пока Индекс >= 0 Цикл
				
				Объект.Докум.Удалить(Доки[Индекс]);
				Индекс = Индекс - 1;
				
			КонецЦикла;
		КОнецЕсли;
		
		Если Доки2.КОличество() > 0 тогда 
			Индекс = Доки2.Количество() - 1;
			Пока Индекс >= 0 Цикл
				
				Объект.Докум.Удалить(Доки2[Индекс]);
				Индекс = Индекс - 1;
				
			КонецЦикла;
		КонецЕсли;
		
		Если Доки3.КОличество() > 0 тогда 
			Индекс = Доки3.Количество() - 1;
			Пока Индекс >= 0 Цикл
				
				Объект.Докум.Удалить(Доки3[Индекс]);
				Индекс = Индекс - 1;
				
			КонецЦикла;
		КОнецЕсли;
		
		Если Доки4.КОличество() > 0 тогда 
			Индекс = Доки4.Количество() - 1;
			Пока Индекс >= 0 Цикл
				
				Объект.Докум.Удалить(Доки4[Индекс]);
				Индекс = Индекс - 1;
				
			КонецЦикла;
		КОнецЕсли;
		
	КонецЦикла;
	ПосчитатьДокументы();
КонецПроцедуры

