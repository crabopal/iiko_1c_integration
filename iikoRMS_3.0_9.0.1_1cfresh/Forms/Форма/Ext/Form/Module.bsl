			для каждого еи из ТекущаяНастройка.СохраненнаяНастройка.ЕдиницыИзмерений цикл
				стр = ТаблицаЕдиницыИзмерений.Добавить();
				стр.ЕдиницаИзмеренияАйко = еи.НазваниеАйко;
				стр.ЕдиницаИзмерения1С = еи.Значение;
