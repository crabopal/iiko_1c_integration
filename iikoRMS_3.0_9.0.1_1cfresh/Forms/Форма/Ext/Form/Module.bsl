&НаКлиенте
Процедура СкладыПередУдалениемНаСервере()
	
	Ответ = Вопрос(
			"Удалить из загрузки все документы со складом " + Этаформа.ТекущийЭлемент.ТекущиеДанные.СкладНаименование + "?"
			, РежимДиалогаВопрос.ДаНет);
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	КодАйко = Этаформа.ТекущийЭлемент.ТекущиеДанные.СкладКод;
	Доки = Объект.Докум.НайтиСТроки(Новый Структура("СкладКодАйко", КодАйко));
	Индекс = Доки.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Объект.Докум.Удалить(Доки[Индекс]);
		Индекс = Индекс - 1;
	КонецЦикла;
	
	УдалитьСкладИзТЗ(КодАйко);
	ПосчитатьДокументы();
	
КонецПроцедуры

