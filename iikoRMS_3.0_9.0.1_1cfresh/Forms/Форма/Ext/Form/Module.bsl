&НаСервере
Функция СоздатьНомерГТД(Номер)
	
	Элемент = Справочники.НомераГТД.СоздатьЭлемент();
	Элемент.Код = Номер;
	Элемент.Записать();
	
	Возврат Элемент.Ссылка;
	
КонецФункции

// Устанавливает время согластно хронологии
&НаСервере
Процедура УстановитьВремяПоУмолчанию(Источник,ВремяДокумента)
	
	ТекущаяДата = НачалоДня(Источник.Дата);
	Источник.Дата  = ТекущаяДата + ВремяДокумента.Часы * 3600 + ВремяДокумента.Минуты * 60
	+ ?(ВремяДокумента.Свойство("Секунды"), ВремяДокумента.Секунды, 0);
	
КонецПроцедуры

Функция СвернутьМассив(пМассив) Экспорт
	
	Если пМассив.Количество() > 1 Тогда
		ТЗ = Новый ТаблицаЗначений;
		ИмяКолонки = "Колонка1";
		ТЗ.Колонки.Добавить(ИмяКолонки);
		Для Индекс = 0 По пМассив.Количество()-1 Цикл
			ТЗ.Добавить();
		КонецЦикла;
		ТЗ.ЗагрузитьКолонку(пМассив, ИмяКолонки);
		ТЗ.Свернуть(ИмяКолонки, "");
		
		Возврат ТЗ.ВыгрузитьКолонку(ИмяКолонки);
	Иначе
		Результат = Новый Массив;
		Для Каждого Элемент Из пМассив Цикл
			Результат.Добавить(Элемент);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПрочитатьФайлБезСтруктуры(Текст,НоменклатураНужна,ТипДок)
	ТЗ = Новый ТаблицаЗначений;
	Шапка = Лев(Текст,СтрНайти(Текст,Символы.ПС)-1);
	МассивШапки = ИзСтрокиВСпис(Шапка);
	СоздатьШапкуТЗ(МассивШапки,ТЗ);	
	Для НомерСтроки = 2 по СтрЧислоСтрок(Текст) цикл
		Строка = СтрПолучитьСтроку(Текст,НомерСтроки);
		МассивСтроки = СтрРазделить(Строка,";");
		ЗаписатьСтрокуВТаблицу(ТЗ,МассивСтроки,НоменклатураНужна);
	КонецЦикла;
	ПереименоватьКолонки(ТЗ,ТипДок);
	Возврат ПоместитьВоВременноеХранилище(ТЗ,УИДФормы);
КонецФункции

&НаСервере
Процедура ЗаписатьСтрокуВТаблицу(ТЗ,МассивСтроки,НоменклатураНужна)
	
	Стр = ТЗ.Добавить();
	
	ПоследняяСтрока = МассивСтроки.Количество()-1;
	
	Для НомерКолонки = 0 ПО ПоследняяСтрока цикл
		Если Сред(МассивСтроки[НомерКОлонки],СтрДлина(МассивСтроки[НомерКОлонки]),1) = Символ(34) И Сред(МассивСтроки[НомерКОлонки],0,1) = Символ(34) тогда
		Стр[НомерКолонки] = Сред(МассивСтроки[НомерКОлонки],2,СтрДлина(МассивСтроки[НомерКОлонки])-2);	
		Иначе			
		Стр[НомерКолонки] = МассивСтроки[НомерКОлонки];	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Процедура СоздатьШапкуТЗ(МассивШапки,ТЗ)
	
	Для каждого Стр из МассивШапки Цикл
		Пока Найти(Стр," ") > 0 ИЛИ Найти(Стр,")") ИЛИ Найти(Стр,"(") ИЛИ Найти(Стр,"/") 
													ИЛИ Найти(Стр,"-") ИЛИ Найти(Стр,".") ИЛИ Найти(Стр,Символы.ПС) ЦИКЛ
			Стр = СтрЗаменить(Стр," ","");
			Стр = СтрЗаменить(Стр,"(","");
			Стр = СтрЗаменить(Стр,")","");
			Стр = СтрЗаменить(Стр,"/","");
			Стр = СтрЗаменить(Стр,"-","");
			Стр = СтрЗаменить(Стр,".","");
			Стр = СтрЗаменить(Стр,Символы.ПС,"");
		КонецЦикла;		
		ТЗ.Колонки.Добавить(Стр);	
	КонецЦикла;
	                                         
КонецПроцедуры


&НаСервере
Процедура ПереименоватьКолонки(ТЗ,ТипДок)
	Если ТипДок = "ПН" Или ТипДок = "АПУ"тогда
		ТЗ.Колонки.Номер.Имя = "НомерДок";
		ТЗ.Колонки.Номенклатуракод.Имя = "НКодИИКО";
		ТЗ.Колонки.Номенклатуранаименование.Имя = "ННаименованиеИИКО";
		ТЗ.Колонки.Поставщиккод.Имя = "ККодИИКО";
		ТЗ.Колонки.Поставщикнаименование.Имя = "КНаименованиеИИКО";
		ТЗ.Колонки.ПоставщикИНН.Имя = "КИННИИКО";
		ТЗ.Колонки.Количество.Имя = "Колво";
				
	ИначеЕсли ТипДок = "АПЕР" Или ТипДок =  "АС"  Или ТипДок = "АП" Или ТипДок =  "ВП" Или ТипДок = "АР" Тогда
		
		Тз.Колонки.Номер.Имя = "НомерДок";
		Тз.Колонки.Номенклатуракод.Имя = "НКодИИКО";
		Тз.Колонки.Номенклатуранаименование.Имя = "ННаименованиеИИКО";
		
	ИначеЕсли ТипДок = "Араз"тогда
	    Тз.Колонки.Номер.Имя = "НомерДок";
		Тз.Колонки.Номенклатуракод.Имя = "НКодИИКО";
		Тз.Колонки.Наименование.Имя = "ННаименованиеИИКО";

	ИначеЕсли ТипДок = "ИН" тогда
		
		Тз.Колонки.Номер.Имя = "НомерДок";
		Тз.Колонки.Себестоимостьзаед.Имя = "СебестоимостьзаедбезНДС";
		Тз.Колонки.Себестоимость.Имя = "СебестоимостьбезНДС";
		Тз.Колонки.Номенклатуракод.Имя = "НКодИИКО";
		Тз.Колонки.Номенклатуранаименование.Имя = "ННаименованиеИИКО";
		
		
	ИначеЕсли ТипДок = "РН" Или ТипДок =  "ВН"  Тогда
		
		Тз.Колонки.Номер.Имя = "НомерДок";
		Тз.Колонки.Номенклатуракод.Имя = "НКодИИКО";
		Тз.Колонки.Номенклатуранаименование.Имя = "ННаименованиеИИКО";
		Тз.Колонки.Покупателькод.Имя = "ККодИИКО";
		Тз.Колонки.Покупательнаименование.Имя = "КНаименованиеИИКО";
		Тз.Колонки.ПокупательИНН.Имя = "КИННИИКО";
		
	ИначеЕсли ТипДок = "АдресАРиБезнал" Тогда
		
		Тз.Колонки.Номер.Имя = "НомерДок";
		
	ИначеЕсли ТипДок = "АУ"  тогда
		
		ТЗ.Колонки.Номер.Имя = "НомерДок";
		ТЗ.Колонки.Номенклатуракод.Имя = "НКодИИКО";
		ТЗ.Колонки.Номенклатуранаименование.Имя = "ННаименованиеИИКО";
		ТЗ.Колонки.Покупателькод.Имя = "ККодИИКО";
		ТЗ.Колонки.Покупательнаименование.Имя = "КНаименованиеИИКО";
		ТЗ.Колонки.ПокупательИНН.Имя = "КИННИИКО";
		ТЗ.Колонки.СуммасНДС.Имя = "СуммаПродажиСНДС";
				
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура СписатьОкругление(ДокСтр, Тзз1)
	
	СписокДокументов = Объект.Докум.НайтиСтроки(Новый Структура("Дата, ВидДок",НачалоДня(ДокСтр.Дата),"Акт Реализации"));
	НужныеСтроки = Тзз1.НайтиСтроки(Новый Структура("Номер,Дата",ДокСтр.Номер,ДокСтр.Дата));
	НужнаяТаблица = Тзз1.Скопировать(НужныеСтроки);//.Итог("СуммасНДС");
	СуммаОкругления = НужнаяТаблица.Итог("СуммасНДС");
	Если СписокДокументов.Количество() = 0 тогда 
		Сообщить("Не обнаружены отчеты о розничных продажах для распределения округления!");
		Возврат;
	КонецЕсли;
	
	Для каждого Стр из СписокДокументов цикл
		Если ЗначениеЗаполнено(Стр.Док) И СуммаОкругления < Стр.Док.СуммаДокумента тогда
			ДокООРП = Стр.Док.ПолучитьОбъект();
			СуммаДокумента = ДокООРП.СуммаДокумента;
			Для каждого строка из ДокООРП.Товары цикл
				Строка.Сумма = Строка.Сумма - (Строка.Сумма/ДокООРП.СуммаДокумента) * СуммаОкругления;
				Строка.Цена = Строка.Сумма/Строка.Количество;					
			КонецЦикла;
			
			//Добавим в последнюю строку лишнюю сумму
			Если ДокООРП.Товары.Итог("Сумма")  <> (СуммаДокумента - СуммаОкругления) тогда 
				Разница = ДокООРП.Товары.Итог("Сумма") - (СуммаДокумента - СуммаОкругления);     //ДокООРП.Товары.Итог("Сумма")
				ДокООРП.Товары[ДокООРП.Товары.Количество()-1].Сумма = ДокООРП.Товары[ДокООРП.Товары.Количество()-1].Сумма + ?(ДокООРП.Товары.Итог("Сумма") > (ДокООРП.Товары.Итог("Сумма") - СуммаОкругления),- Разница,Разница);//Макс(ДокООРП.Товары.Итог("Сумма") - СуммаВсего, -(ДокООРП.Товары.Итог("Сумма") - СуммаВсего));
				ДокООРП.Товары[ДокООРП.Товары.Количество()-1].Цена = ДокООРП.Товары[ДокООРП.Товары.Количество()-1].Сумма / ДокООРП.Товары[ДокООРП.Товары.Количество()-1].Количество;
			КонецЕсли;
			Если ДокООРП.Проведен тогда
				ДокООРП.Записать(РежимЗаписиДокумента.Проведение);
				Прервать;
			Иначе
				ДокООРП.Записать(РежимЗаписиДокумента.Запись);
				Прервать;
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
	
	
КонецПроцедуры

