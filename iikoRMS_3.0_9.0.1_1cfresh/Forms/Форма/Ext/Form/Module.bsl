&НаСервере
Функция ПолучитьСтавкуНДС(СтавкаЧисло,Сумма,СуммаНДС)
	
	Если Укр = 0 Тогда
		Если СтавкаЧисло = 18 Тогда
			Возврат Перечисления.СтавкиНДС.НДС18;
		ИначеЕсли СтавкаЧисло = 20 тогда			
			Возврат Перечисления.СтавкиНДС.НДС20;
		ИначеЕсли СтавкаЧисло = 22 тогда
			Возврат Перечисления.СтавкиНДС.НДС22;
		ИначеЕсли СтавкаЧисло = 10 Тогда
			Возврат Перечисления.СтавкиНДС.НДС10;
		ИначеЕсли СтавкаЧисло = 5 тогда 
			ВОзврат Перечисления.СтавкиНДС.НДС5;
		ИначеЕсли СтавкаЧисло = 7 тогда 
			ВОзврат Перечисления.СтавкиНДС.НДС7;			
		Иначе
			Возврат Перечисления.СтавкиНДС.БезНДС;
		КонецЕсли;
		
	Иначе
		Ставка =  Перечисления.СтавкиНДС.НДС20;
	КонецЕсли;
	
	Возврат Ставка;
	
КонецФункции

&НаСервере
Процедура ПрименитьНевыделениеНДС(СтрокаДокумента)
	
	// УСН и режим «НДС не выделять»: ставка и сумма НДС в строке всё равно
	// приходили из файла iiko, и проведение ставило суммы на 19 и 90.03.
	Если Не (_НДСНеВыделять Или _ДокументБезНДС) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не _СуммаВключаетНДС И СтрокаДокумента.СуммаНДС <> 0 Тогда
		СтрокаДокумента.Сумма = СтрокаДокумента.Сумма + СтрокаДокумента.СуммаНДС;
		Если СтрокаДокумента.Количество <> 0 Тогда
			СтрокаДокумента.Цена = СтрокаДокумента.Сумма / СтрокаДокумента.Количество;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаДокумента.СуммаНДС = 0;
	СтрокаДокумента.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНоменклатуруВыручки()
	
	Если ЗначениеЗаполнено(НоменклатураВыручки) Тогда
		Если НоменклатураВыручки.Услуга Тогда
			Возврат НоменклатураВыручки;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяУслуги = "Розничная выручка (iiko)";
	Найденная = Справочники.Номенклатура.НайтиПоНаименованию(ИмяУслуги, Истина);
	Если ЗначениеЗаполнено(Найденная) И Не Найденная.ЭтоГруппа И Найденная.Услуга Тогда
		НоменклатураВыручки = Найденная;
		Возврат Найденная;
	КонецЕсли;
	
	Ном = Справочники.Номенклатура.СоздатьЭлемент();
	Ном.Наименование = ИмяУслуги;
	Ном.НаименованиеПолное = ИмяУслуги;
	Ном.Услуга = Истина;
	ВидУслуги = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Услуги", Истина);
	Если ЗначениеЗаполнено(ВидУслуги) Тогда
		Ном.ВидНоменклатуры = ВидУслуги;
	КонецЕсли;
	Ном.НоменклатурнаяГруппа = ОсновнаяНоменклатурнаяГруппа;
	Ном.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	Если Не ЗначениеЗаполнено(Ном.ЕдиницаИзмерения) И ЗначениеЗаполнено(ЕдиницаИзмеренияДефолтная) Тогда
		Ном.ЕдиницаИзмерения = ЕдиницаИзмеренияДефолтная;
	КонецЕсли;
	
	Попытка
		Ном.Записать();
	Исключение
		Сообщить("Не удалось создать номенклатуру выручки: " + ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
		Возврат Неопределено;
	КонецПопытки;
	
	НоменклатураВыручки = Ном.Ссылка;
	Сообщить("Создана услуга """ + ИмяУслуги + """ для выручки розничных продаж.");
	Возврат Ном.Ссылка;
	
КонецФункции

&НаСервере
Функция ПолучитьСтавкуНДС2(СтавкаСтрока)
	
	СтавкаЧисло = Число(СокрЛП(СтавкаСтрока));
	
	НомерПодредакции = ПолучитьНомерПодредакции();	 
	
	
	Если НомерПодредакции > 67 тогда
		Если СтавкаЧисло = 18 Тогда
			Возврат Перечисления.ВидыСтавокНДС.Общая;
		ИначеЕсли СтавкаЧисло = 20 тогда			
			Возврат Перечисления.ВидыСтавокНДС.Общая;
		ИначеЕсли СтавкаЧисло = 22 тогда
			Возврат Перечисления.СтавкиНДС.НДС22;
		ИначеЕсли СтавкаЧисло = 10 Тогда
			Возврат Перечисления.ВидыСтавокНДС.Пониженная;
		ИначеЕсли СтавкаЧисло = 5 Тогда
			Возврат Перечисления.ВидыСтавокНДС.ПониженнаяУСН;
		ИначеЕсли СтавкаЧисло = 7 Тогда
			Возврат Перечисления.ВидыСтавокНДС.ОбщаяУСН;
		Иначе
			Возврат Перечисления.ВидыСтавокНДС.БезНДС;
		КонецЕсли;
	Иначе
		Если СтавкаЧисло = 18 Тогда
			Возврат Перечисления.СтавкиНДС.НДС18;		
		ИначеЕсли СтавкаЧисло = 10 Тогда
			Возврат Перечисления.СтавкиНДС.НДС10;
		Иначе
			Возврат Перечисления.СтавкиНДС.БезНДС;
		КонецЕсли; 	
	КонецЕсли;	
	
	
КонецФункции

